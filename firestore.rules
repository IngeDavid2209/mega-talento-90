// =====================================================================
// Reglas de Firestore · Mega Talento 90  (proyecto: megatalento-a3450)
// Pegar este contenido en Firebase Console:
//   https://console.firebase.google.com/project/megatalento-a3450/firestore/rules
//
// OJO: este proyecto es SOLO el de candidatos (puestos / candidates /
// usuarios de RH). NO confundir con el proyecto de "Mega Dulces Task"
// (checklists, rutinas, tec_*), que tiene sus propias reglas aparte.
// =====================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- PUESTOS / VACANTES ----------
    // Lectura PÚBLICA: el portal /portal y la cartelera /empleos las muestran
    // a candidatos sin login. Escritura solo para RH autenticado.
    match /puestos/{puesto} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ---------- CANDIDATES ----------
    // CREATE público: cualquiera puede postularse desde /unete.
    // UPDATE público: /solicitud y /evaluacion/:id actualizan al candidato
    //   existente sin login (el id autogenerado actúa como token).
    // GET público (por ID): esos mismos flujos leen el documento cuyo id conocen.
    // LIST solo autenticado: nadie sin login enumera/descarga toda la colección.
    // DELETE solo autenticado (solo RH borra expedientes).
    match /candidates/{candidato} {
      allow create: if true;
      allow update: if true;
      allow get: if true;
      allow list: if request.auth != null;
      allow delete: if request.auth != null;

      // Subcolecciones de candidates (si existen): solo autenticado
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ---------- ÍNDICE DE TELÉFONOS (anti-duplicados) ----------
    // Documentos llaveados por el teléfono normalizado (10 dígitos), p.ej.
    // telefonos/3521532421. Permite que /unete detecte repostulaciones sin
    // poder LISTAR la colección privada de candidatos.
    // GET público: /unete consulta UN número exacto (el suyo) con getDoc; no
    //   expone datos de nadie más ni permite enumerar.
    // CREATE público: al postularse por primera vez se registra el número.
    // LIST/UPDATE/DELETE solo autenticado (incluido el backfill de RH).
    match /telefonos/{telefono} {
      allow get: if true;
      allow create: if true;
      allow list, update, delete: if request.auth != null;
    }

    // ---------- USUARIOS DE RH ----------
    // READ público: el login resuelve username → email ANTES de autenticarse.
    //   No expone contraseñas (esas viven en Firebase Auth, no en Firestore).
    // WRITE solo autenticado (solo RH crea/edita cuentas).
    match /usuarios/{usuario} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
