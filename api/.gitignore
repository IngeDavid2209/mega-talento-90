node_modules/
dist/
.env
.env.local
*.log

# ==== Agente local de checadas (api/agente) ====
# config.json lleva el token de ingesta y la contraseña del Postgres del
# proveedor. NUNCA se versiona: el ejemplo sin secretos es config.ejemplo.json.
agente/config.json
# La cola local (SQLite) es estado de ESA máquina, no del proyecto.
agente/cola.db
agente/cola.db-wal
agente/cola.db-shm
agente/logs/
# Propuestas de traducción de códigos: llevan nombres de empleados.
tools/mapeo-*.csv
tools/diagnostico*.json
# node-windows genera esto al instalar el servicio: el .exe de winsw y un .xml
# con rutas ABSOLUTAS de la máquina donde se instaló. Versionarlo hace que otra
# PC herede la configuración de esta, y ensucia cada commit con el alta local.
agente/daemon/

# Datos derivados de los reportes: llevan nombres de empleados.
tools/reportes-sem33.json
