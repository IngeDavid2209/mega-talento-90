{
  "name": "mega-talento-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API (Postgres) para Mega Talento 90 · intermediario entre el front Angular y Postgres/Railway",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "tsx src/scripts/migrate.ts",
    "seed:admin": "node dist/scripts/seed-admin.js",
    "seed:admin:dev": "tsx src/scripts/seed-admin.ts",
    "limpiar:dup-rfc": "tsx src/scripts/limpiar-dup-rfc.ts",
    "jalar": "node tools/jalar-todo-zk.js",
    "jalar:watch": "node tools/jalar-todo-zk.js --loop",
    "estado": "node tools/estado-datos.js",
    "probar:horario": "tsx tools/probar-horario.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.2",
    "node-zklib": "^1.3.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
