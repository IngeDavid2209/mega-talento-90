# ==== Conexión a Postgres (Railway) ====
# En Railway usa la variable de referencia ${{ Postgres.DATABASE_URL }}.
# Para conectarte desde tu máquina, copia la "Public Network" connection string.
DATABASE_URL=postgresql://usuario:password@host:puerto/basededatos

# ¿Usar SSL al conectar? Railway (red pública) lo requiere → true.
PGSSL=true

# ==== Auth (JWT) ====
# Secreto largo y aleatorio. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ==== Servidor ====
PORT=3000
# Orígenes permitidos para CORS (el front en Vercel). Separa varios con comas.
# Usa * SOLO en desarrollo.
CORS_ORIGIN=https://tu-front.vercel.app

# ==== Agente de Horarios: aviso al jefe por WhatsApp (Fase 2b) ====
# La API no tiene credenciales de WhatsApp; el BOT-RH sí. El aviso al jefe se
# manda llamando al bot, y el bot regresa la justificación del jefe al callback
# POST /checador/agente/callback/justificar.
#
# Base del BOT-RH. Si se deja VACÍA, no se notifica a nadie (no-op): la
# aprobación de RH nunca se rompe por culpa de la notificación.
BOT_RH_URL=https://bot-rh-production.up.railway.app
#
# Secreto COMPARTIDO con el bot (header x-aviso-secret), en las dos direcciones.
# Debe ser EL MISMO valor que AVISO_ASISTENCIA_SECRET del BOT-RH.
# Genera uno con: openssl rand -hex 32
AVISO_ASISTENCIA_SECRET=cambia-esto-y-usa-el-mismo-en-el-bot

# ==== Seed del admin inicial (solo para `npm run seed:admin`) ====
ADMIN_EMAIL=desarrollador.david@megadulces.com.mx
ADMIN_PASSWORD=defíneme-una-contraseña
ADMIN_NOMBRE=David
