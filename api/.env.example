# ==== Conexión a Postgres (Railway) ====
# En Railway usa la variable de referencia ${{ Postgres.DATABASE_URL }}.
# Para conectarte desde tu máquina, copia la "Public Network" connection string.
DATABASE_URL=postgresql://usuario:password@host:puerto/basededatos

# ¿Usar SSL al conectar? Railway (red pública) lo requiere → true.
PGSSL=true

# ==== Auth (JWT) ====
# Secreto largo y aleatorio. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ==== Servidor ====
PORT=3000
# Orígenes permitidos para CORS (el front en Vercel). Separa varios con comas.
# Usa * SOLO en desarrollo.
CORS_ORIGIN=https://tu-front.vercel.app

# ==== Seed del admin inicial (solo para `npm run seed:admin`) ====
ADMIN_EMAIL=desarrollador.david@megadulces.com.mx
ADMIN_PASSWORD=defíneme-una-contraseña
ADMIN_NOMBRE=David
